# Where visitor measurement events are POSTed. Leave empty to measure locally
# without sending anything (the debug panel still works).
VITE_STATS_ENDPOINT=https://api.example.com/kiosk/stats

# Optional; sent as "Authorization: Bearer <token>".
VITE_STATS_TOKEN=

# Which mirror this is. When unset a random id is generated and kept in
# localStorage, so a kiosk keeps its identity across reloads.
VITE_KIOSK_ID=jm-optiek-winkel-1

# How strictly a returning visitor is matched to an earlier visit that day.
# Lower = stricter (someone coming back is more likely counted as a new face);
# higher = looser (risks merging two different people). Default 0.02.
VITE_VISIT_MATCH_THRESHOLD=

# How long the mirror may lose a face before the visit is closed (ms).
# Default 8000. Lower fragments one session into several visits; much higher
# risks pulling a different person into the running visit.
VITE_VISIT_ABSENCE_GAP_MS=
